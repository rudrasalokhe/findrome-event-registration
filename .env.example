# Findrome NMIMS — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.x5sjia2.mongodb.net"
SECRET_KEY="your-secret-key-here"
VOLUNTEER_PIN="lol"
ADMIN_PASSWORD="example"
PORT=5000

# Event Reminder Email Dispatch (SMTP) — Optional
# If not configured, reminders run seamlessly in simulated test mode with delivery logs
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME="your-committee-email@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
SMTP_FROM_EMAIL="your-committee-email@gmail.com"
SMTP_FROM_NAME="Findrome Organizing Committee"
